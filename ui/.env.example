# Copy this file to .env.local and adjust for your local setup.
# See lib/env.ts for validation of these variables.

# Base URL of the backend API (Laravel, api/). Must be a well-formed URL.
# Falls back to the production API if unset.
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Set to "enabled" to boot the MSW mock service worker in the browser
# instead of hitting a real backend. This is set automatically by
# playwright.config.ts for e2e test runs — you shouldn't need to set it
# by hand for normal local development.
# NEXT_PUBLIC_API_MOCKING="enabled"
